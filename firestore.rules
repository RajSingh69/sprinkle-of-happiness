rules_version = '2';

// Sprinkle of Happiness Firestore rules.
// - Members can only read and edit their own profile, and only after
//   verifying their email address.
// - Admin access comes from the `admin` custom claim, which can only be set
//   with the Firebase Admin SDK (see _tools/admin-bootstrap). Nothing a user
//   writes to Firestore can grant admin rights.
// - Memberships, subscriptions, payments, bookings and every other collection
//   stay locked until trusted backend logic exists.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function isAdmin() {
      return verified() && request.auth.token.get('admin', false) == true;
    }

    function isVerifiedOwner(uid) {
      return verified() && request.auth.uid == uid;
    }

    // Set when a member deletes their account. Firebase never reuses UIDs, so
    // a tombstone permanently stops that UID from recreating a profile, even
    // with an ID token issued before deletion (which stays valid until expiry).
    function isTombstoned(uid) {
      return exists(/databases/$(database)/documents/deletedAccounts/$(uid));
    }

    // True while a Stripe subscription could still charge the member. The
    // status is written only by the trusted Stripe webhook (Cloud Functions).
    function hasLiveSubscription(uid) {
      let path = /databases/$(database)/documents/subscriptions/$(uid);
      return exists(path)
        && get(path).data.status in ['active', 'trialing', 'past_due', 'unpaid', 'incomplete', 'paused'];
    }

    function validDisplayName(name) {
      return name is string && name.size() >= 1 && name.size() <= 60;
    }

    match /users/{uid} {
      allow get: if (isVerifiedOwner(uid) && !isTombstoned(uid)) || isAdmin();
      allow list: if isAdmin();

      // A new profile holds exactly these five fields, and the membership tier
      // can only ever start as "free". Paid tiers, roles, subscriptionStatus
      // or stripeCustomerId can only be set by trusted server code (Admin SDK).
      allow create: if isVerifiedOwner(uid)
        && !isTombstoned(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'updatedAt', 'membershipTier'])
        && request.resource.data.keys().hasAll(['displayName', 'email', 'createdAt', 'updatedAt', 'membershipTier'])
        && request.resource.data.membershipTier == 'free'
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isVerifiedOwner(uid)
        && !isTombstoned(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.updatedAt == request.time;

      // Members delete their own profile only together with a tombstone, in
      // the same batch. Admins cannot delete their profile from the browser,
      // so an administrator cannot remove their own account by accident.
      allow delete: if isVerifiedOwner(uid)
        && !isAdmin()
        && !hasLiveSubscription(uid)
        && existsAfter(/databases/$(database)/documents/deletedAccounts/$(uid));
    }

    // Tombstones hold no personal data and can never be read, changed or
    // removed from the browser. One can only be created alongside deleting
    // the owner's profile.
    match /deletedAccounts/{uid} {
      allow create: if isVerifiedOwner(uid)
        && !isAdmin()
        && request.resource.data.keys().hasOnly(['deletedAt'])
        && request.resource.data.deletedAt == request.time
        && exists(/databases/$(database)/documents/users/$(uid))
        && !existsAfter(/databases/$(database)/documents/users/$(uid));
    }

    // Billing state written by the Stripe webhook. Members can read their own;
    // admins can read all. Nobody can write it from the browser.
    match /subscriptions/{uid} {
      allow get: if (isVerifiedOwner(uid) && !isTombstoned(uid)) || isAdmin();
      allow list: if isAdmin();
    }

    // billing/{uid}, stripeCustomers/{id} and stripeEvents/{id} hold Stripe
    // customer links and webhook markers. They are server-only and fall
    // through to the default deny below.

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

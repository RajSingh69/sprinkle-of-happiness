{
  "name": "soh-tests",
  "private": true,
  "type": "module",
  "description": "Unit tests, Firestore rules tests and the membership journey (Auth + Firestore emulators).",
  "scripts": {
    "test:unit": "node --test unit/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sprinkle --config ../firebase.json \"node --test rules/*.test.mjs\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:journey",
    "test:journey": "firebase emulators:exec --only auth,firestore --project demo-sprinkle --config ../firebase.json \"node --test journey/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0"
  }
}
